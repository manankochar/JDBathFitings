import React, { useState, useEffect } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import {
  Box,
  Container,
  Heading,
  Text,
  Image,
  Button,
  VStack,
  HStack,
  Grid,
  GridItem,
  AspectRatio,
  SimpleGrid,
  Flex,
  Center,
  Badge,
  Icon
} from '@chakra-ui/react';
import { 
  FaArrowLeft, 
  FaPhone, 
  FaEnvelope, 
  FaWhatsapp, 
  FaMapMarkerAlt, 
  FaStar,
  FaTools,
  FaHeart,
  FaShare,
  FaBookmark,
  FaShieldAlt,
  FaAward,
  FaPlay,
  FaExpand,
  FaCheckCircle,
  FaGem,
  FaCrown,
  FaMagic
} from 'react-icons/fa';
import { motion } from 'framer-motion';
import { productsData } from '../data/productsData';
import { colors, gradients, shadows } from '../theme/colors';

const MotionBox = motion(Box);
const MotionText = motion(Text);
const MotionHeading = motion(Heading);

const ProductDetailPage = () => {
  const { id } = useParams();
  const navigate = useNavigate();
  const [product, setProduct] = useState(null);
  const [loading, setLoading] = useState(true);
  const [isLiked, setIsLiked] = useState(false);
  
  // Luxury purple theme matching website
  const bgGradient = `linear-gradient(135deg, #ffffff 0%, #f8fafc 15%, ${colors.accent}0A 35%, #e2e8f0 100%)`;
  const cardBg = 'rgba(255, 255, 255, 0.98)';
  const accentColor = colors.accent;
  const accentLight = colors.accentTint;
  const accentDark = colors.accentStrong;
  const accentGradient = gradients.accentLinear;
  const accentShadowStrong = shadows.accentStrong;
  const accentShadowMedium = shadows.accentMedium;
  const accentWithAlpha = (alphaHex = '20') => `${accentColor}${alphaHex}`;
  const accentShadowColor = (alpha = 0.1) => `rgba(34, 4, 56, ${alpha})`;
  const accentShadow10 = accentShadowColor(0.1);
  const accentShadow20 = accentShadowColor(0.2);
  const accentShadow30 = accentShadowColor(0.3);

  useEffect(() => {
    const fetchProduct = () => {
      try {
        const productId = parseInt(id, 10);
        const foundProduct = productsData.find(p => p.id === productId);
        
        if (foundProduct) {
          setProduct(foundProduct);
        } else {
          setProduct(null);
        }
      } catch (error) {
        console.error('Error fetching product:', error);
        setProduct(null);
      } finally {
        setLoading(false);
      }
    };

    fetchProduct();
  }, [id]);

  const handleContactClick = (type) => {
    const message = `Hi! I'm interested in the ${product?.name} product. Could you please provide more details?`;
    
    switch (type) {
      case 'whatsapp':
        window.open(`https://wa.me/919876543210?text=${encodeURIComponent(message)}`, '_blank');
        break;
      case 'phone':
        window.open('tel:+919876543210', '_self');
        break;
      case 'email':
        window.open(`mailto:rdiamond2423@gmail.com?subject=Inquiry about ${product?.name}&body=${encodeURIComponent(message)}`, '_blank');
        break;
      default:
        break;
    }
  };

  if (loading) {
    return (
      <Box 
        minH="100vh" 
        bg={bgGradient}
        display="flex" 
        alignItems="center" 
        justifyContent="center"
        position="relative"
        overflow="hidden"
        pt={{ base: 20, md: 24 }}
      >
        {/* Elegant background pattern */}
        <Box
          position="absolute"
          top="0"
          left="0"
          right="0"
          bottom="0"
          opacity="0.05"
          backgroundImage={`radial-gradient(circle at 20px 20px, ${accentColor}20 1px, transparent 1px)`}
          backgroundSize="40px 40px"
        />
        
        <VStack spacing={8} position="relative" zIndex={1}>
          <Box
            w={16}
            h={16}
            border="3px solid"
            borderColor="rgba(30, 77, 140, 0.2)"
            borderTopColor={accentColor}
            borderRadius="full"
            animation="spin 1s linear infinite"
            boxShadow="0 0 20px rgba(212, 175, 55, 0.2)"
          />
          <MotionText
            color="gray.800"
            fontSize="xl"
            fontWeight="600"
            textAlign="center"
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.6 }}
          >
            Loading Premium Product...
          </MotionText>
        </VStack>
      </Box>
    );
  }

  if (!product) {
    const accentSoftFill = accentWithAlpha('40');
    const accentButtonGradient = gradients.accentLinear;
    return (
      <Box minH="100vh" bg={bgGradient} position="relative" overflow="hidden" pt={{ base: 20, md: 24 }}>
        {/* Luxury background pattern */}
        <Box
          position="absolute"
          top="0"
          left="0"
          right="0"
          bottom="0"
          opacity="0.05"
          backgroundImage={`
            radial-gradient(circle at 25% 25%, rgba(100,116,139,0.05) 0%, transparent 50%),
            radial-gradient(circle at 75% 75%, ${colors.accent}14 0%, transparent 50%),
            radial-gradient(circle at 50% 10%, ${colors.accent}0D 0%, transparent 40%)
          `}
        />
        
        <Container maxW="container.xl" py={20} pt={{ base: 24, md: 28 }}>
          <Center>
            <MotionBox 
              maxW="lg" 
              bg={cardBg}
              backdropFilter="blur(20px)"
              boxShadow="0 20px 40px rgba(0,0,0,0.1)"
              borderRadius="2xl" 
              p={16} 
              textAlign="center"
              border={`1px solid ${accentColor}30`}
              initial={{ opacity: 0, y: 50, scale: 0.9 }}
              animate={{ opacity: 1, y: 0, scale: 1 }}
              transition={{ duration: 0.8, ease: "easeOut" }}
            >
              <Box fontSize="8xl" mb={8} opacity="0.9">💎</Box>
              <MotionHeading 
                fontSize="4xl" 
                color="gray.800"
                fontWeight="800" 
                mb={6}
                bgGradient={accentGradient}
                bgClip="text"
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.6, delay: 0.2 }}
              >
                Product Not Found
              </MotionHeading>
              <MotionText 
                fontSize="xl" 
                color="gray.600" 
                mb={10} 
                lineHeight="1.6"
                fontWeight="500"
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.6, delay: 0.4 }}
              >
                The premium product you're looking for doesn't exist or has been removed from our collection.
              </MotionText>
              <MotionBox
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.6, delay: 0.6 }}
              >
                <Button
                  onClick={() => navigate('/all-products')}
                  leftIcon={<FaArrowLeft />}
                  bgGradient={accentButtonGradient}
                  color="white"
                  size="xl"
                  borderRadius="xl"
                  px={10}
                  py={8}
                  fontWeight="700"
                  fontSize="lg"
                  boxShadow={accentShadowMedium}
                  _hover={{ 
                    transform: "translateY(-3px)",
                    boxShadow: accentShadowStrong
                  }}
                  transition="all 0.3s ease"
                >
                  Explore Our Collection
                </Button>
              </MotionBox>
            </MotionBox>
          </Center>
        </Container>
      </Box>
    );
  }

  return (
    <Box minH="100vh" bg={bgGradient} position="relative" overflow="hidden" px={{ base: 4, md: 10 }}>
      {/* Luxury background pattern */}
      <Box
        position="absolute"
        top="0"
        left="0"
        right="0"
        bottom="0"
        opacity="0.05"
        backgroundImage={`
          radial-gradient(circle at 25% 25%, rgba(100,116,139,0.05) 0%, transparent 50%),
          radial-gradient(circle at 75% 75%, ${colors.accent}14 0%, transparent 50%),
          radial-gradient(circle at 50% 10%, ${colors.accent}0D 0%, transparent 40%),
          radial-gradient(circle at 10% 80%, ${colors.accent}0F 0%, transparent 45%)
        `}
      />
      
      {/* Floating geometric shapes */}
      <Box position="absolute" top="10%" left="10%" w="100px" h="100px" opacity={0.1} pointerEvents="none">
        <Box
          w="100%"
          h="100%"
          borderRadius="30% 70% 70% 30% / 30% 30% 70% 70%"
          bg="linear-gradient(45deg, #64748b, #1e293b)"
          animation="float 6s ease-in-out infinite"
        />
      </Box>
      
      <Box position="absolute" top="60%" right="15%" w="80px" h="80px" opacity={0.1} pointerEvents="none">
        <Box
          w="100%"
          h="100%"
          borderRadius="63% 37% 54% 46% / 55% 48% 52% 45%"
          bg={`linear-gradient(45deg, ${colors.accent}, #64748b)`}
          animation="float 8s ease-in-out infinite reverse"
        />
      </Box>

      {/* Navigation Header */}
      <Box position="relative" zIndex={2} py={8} pt={{ base: 24, md: 28 }}>
        <Container maxW="container.xl">
          <MotionBox
            initial={{ opacity: 0, y: -20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.6 }}
          >
            <Flex 
              align="center" 
              justify="space-between" 
              mb={{ base: 8, md: 12 }}
              flexDir={{ base: "column", sm: "row" }}
              gap={{ base: 4, sm: 0 }}
            >
              <Button
                onClick={() => navigate('/all-products')}
                leftIcon={<FaArrowLeft />}
                bgGradient={gradients.accentLinear}
                color="white"
                size={{ base: "md", md: "lg" }}
                fontWeight="800"
                borderRadius="xl"
                border="none"
                boxShadow={`0 10px 30px ${colors.accentGlow}`}
                _hover={{ 
                  transform: "translateX(-4px) translateY(-2px)",
                  boxShadow: `0 15px 40px ${colors.accentGlow}`
                }}
                transition="all 0.4s ease"
              >
                Back to Collection
              </Button> 
              
              <HStack spacing={4}>
                <Button
                  leftIcon={<FaShare />}
                  bg="white"
                  color={accentColor}
                  size="lg"
                  borderRadius="xl"
                  border={`2px solid ${colors.accent}20`}
                  boxShadow={`0 8px 20px ${accentShadow10}`}
                  fontWeight="700"
                  _hover={{ 
                    bgGradient: gradients.accentLinear,
                    color: "white",
                    transform: "translateY(-3px)",
                    boxShadow: `0 12px 30px ${colors.accentGlow}`,
                    borderColor: "transparent"
                  }}
                  transition="all 0.4s ease"
                >
                  Share
                </Button>
                <Button
                  leftIcon={isLiked ? <FaHeart /> : <FaBookmark />}
                  bgGradient={isLiked ? gradients.accentLinear : "linear(to-r, white, white)"}
                  color={isLiked ? "white" : accentColor}
                  size="lg"
                  borderRadius="xl"
                  border={isLiked ? "none" : `2px solid ${colors.accent}20`}
                  boxShadow={isLiked ? `0 10px 30px ${colors.accentGlow}` : `0 8px 20px ${accentShadow10}`}
                  fontWeight="700"
                  _hover={{ 
                    bgGradient: gradients.accentLinear,
                    color: "white",
                    transform: "translateY(-3px)",
                    boxShadow: `0 12px 30px ${colors.accentGlow}`,
                    borderColor: "transparent"
                  }}
                  onClick={() => setIsLiked(!isLiked)}
                  transition="all 0.4s ease"
                >
                  {isLiked ? 'Saved' : 'Save'}
                </Button>
              </HStack>
            </Flex>
          </MotionBox>

          {/* Main Product Display */}
          <Grid 
            templateColumns={{ base: "1fr", lg: "1fr 1fr" }} 
            gap={{ base: 6, md: 10, lg: 16 }} 
            align="start" 
            mt={{ base: 4, md: 8 }}
            mx="auto"
            maxW="100%"
            px={{ base: 2, md: 4 }}
          >
            
            {/* Product Image Gallery */}
            <GridItem w="100%" maxW={{ base: "100%", lg: "600px" }} mx={{ base: "0", lg: "auto" }}>
              <MotionBox
                initial={{ opacity: 0, x: -50 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ duration: 0.8, delay: 0.2 }}
              >
                <Box 
                  bg={cardBg}
                  backdropFilter="blur(30px)"
                  boxShadow={`0 20px 40px ${accentShadow20}`}
                  borderRadius="3xl" 
                  overflow="hidden" 
                  position="relative"
                  border={`1px solid ${accentColor}30`}
                  _before={{
                    content: '""',
                    position: 'absolute',
                    top: 0,
                    left: 0,
                    right: 0,
                    bottom: 0,
                    background: `linear-gradient(45deg, ${accentColor}10, transparent, ${accentColor}10)`,
                    zIndex: 1
                  }}
                >
                  {/* Premium Badge */}
                  <Box position="absolute" top={{ base: 4, md: 8 }} left={{ base: 4, md: 8 }} zIndex={3}>
                    <Badge
                      bgGradient={accentGradient}
                      color="white"
                      borderRadius="full"
                      px={{ base: 3, md: 6 }}
                      py={{ base: 2, md: 3 }}
                      fontSize={{ base: "xs", md: "sm" }}
                      fontWeight="800"
                      textTransform="uppercase"
                      letterSpacing={{ base: "1px", md: "1.5px" }}
                      boxShadow={`0 10px 25px ${colors.accentGlow}`}
                      border="2px solid rgba(255,255,255,0.3)"
                      backdropFilter="blur(10px)"
                    >
                      <Icon as={FaGem} mr={{ base: 1, md: 2 }} boxSize={{ base: 3, md: 4 }} />
                      <Text display={{ base: "none", sm: "inline" }}>{product.type || product.category}</Text>
                      <Text display={{ base: "inline", sm: "none" }}>{(product.type || product.category).substring(0, 8)}</Text>
                    </Badge>
                  </Box>

                  {/* Main Product Image */}
                  <Box position="relative">
                    <AspectRatio ratio={{ base: 1, md: 4/5 }}>
                      <Box
                        bg="white"
                        display="flex"
                        alignItems="center"
                        justifyContent="center"
                        p={{ base: 6, sm: 10, md: 16 }}
                        position="relative"
                        overflow="hidden"
                      >
                        {/* Elegant background pattern */}
                        <Box
                          position="absolute"
                          top="0"
                          left="0"
                          right="0"
                          bottom="0"
                          opacity="0.03"
                          backgroundImage={`radial-gradient(circle at 20px 20px, ${accentColor}40 1px, transparent 1px)`}
                          backgroundSize="40px 40px"
                          transform="rotate(45deg)"
                        />
                        
                        {product.image ? (
                          <Image
                            src={product.image}
                            alt={product.name}
                            maxH="100%"
                            maxW="100%"
                            w="auto"
                            h="auto"
                            objectFit="contain"
                            transition="transform 0.6s ease"
                            _hover={{ transform: "scale(1.08)" }}
                            filter={`drop-shadow(0 20px 40px ${accentColor}20)`}
                            zIndex={2}
                            loading="lazy"
                            onError={(e) => {
                              e.target.style.display = 'none';
                              e.target.parentElement.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center;gap:1rem;color:#9ca3af;"><div style="font-size:4rem;opacity:0.8;">💎</div><div style="font-weight:700;font-size:1.25rem;color:#1f2937;text-align:center;">' + product.name + '</div><div style="font-size:1rem;color:#6b7280;">Premium Product</div></div>';
                            }}
                          />
                        ) : (
                          <VStack spacing={{ base: 4, md: 8 }} color="gray.400">
                            <Box fontSize={{ base: "4xl", md: "8xl" }} opacity="0.8">💎</Box>
                            <Text fontWeight="700" fontSize={{ base: "lg", md: "2xl" }} color="gray.800" textAlign="center">{product.name}</Text>
                            <Text fontSize={{ base: "sm", md: "lg" }} color="gray.600">Premium Product</Text>
                          </VStack>
                        )}
                        
                        {/* Luxury overlay actions */}
                        <HStack 
                          position="absolute" 
                          top={{ base: 3, md: 6 }} 
                          right={{ base: 3, md: 6 }} 
                          spacing={{ base: 2, md: 3 }} 
                          zIndex={3}
                          display={{ base: "none", sm: "flex" }}
                        >
                          <Button
                            leftIcon={<FaExpand />}
                            size={{ base: "sm", md: "md" }}
                            bg="rgba(255,255,255,0.95)"
                            color={accentColor}
                            borderRadius="full"
                            border={`2px solid ${colors.accent}20`}
                            boxShadow="0 8px 20px rgba(0,0,0,0.15)"
                            backdropFilter="blur(10px)"
                            fontWeight="700"
                            _hover={{ 
                              bgGradient: gradients.accentLinear,
                              color: "white",
                              transform: "scale(1.1)",
                              boxShadow: `0 12px 30px ${colors.accentGlow}`,
                              borderColor: "transparent"
                            }}
                            minW="auto"
                            px={{ base: 3, md: 4 }}
                            py={{ base: 2, md: 3 }}
                            transition="all 0.4s ease"
                          />
                          <Button
                            leftIcon={<FaPlay />}
                            size={{ base: "sm", md: "md" }}
                            bg="rgba(255,255,255,0.95)"
                            color={accentColor}
                            borderRadius="full"
                            border={`2px solid ${colors.accent}20`}
                            boxShadow="0 8px 20px rgba(0,0,0,0.15)"
                            backdropFilter="blur(10px)"
                            fontWeight="700"
                            _hover={{ 
                              bgGradient: gradients.accentLinear,
                              color: "white",
                              transform: "scale(1.1)",
                              boxShadow: `0 12px 30px ${colors.accentGlow}`,
                              borderColor: "transparent"
                            }}
                            minW="auto"
                            px={{ base: 3, md: 4 }}
                            py={{ base: 2, md: 3 }}
                            transition="all 0.4s ease"
                          />
                        </HStack>
                      </Box>
                    </AspectRatio>
                  </Box>
                </Box>
              </MotionBox>
            </GridItem>

            {/* Product Information */}
            <GridItem>
              <MotionBox
                initial={{ opacity: 0, x: 50 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ duration: 0.8, delay: 0.4 }}
              >
                <VStack spacing={10} align="stretch">
                  
                  {/* Product Title & Description */}
                  <Box 
                    bg={cardBg}
                    backdropFilter="blur(30px)"
                    boxShadow={`0 20px 40px ${accentShadow20}`}
                    borderRadius={{ base: "2xl", md: "3xl" }}
                    p={{ base: 6, sm: 8, md: 12 }}
                    border={`1px solid ${accentColor}30`}
                    position="relative"
                    overflow="hidden"
                  >
                    {/* Elegant background accent */}
                    <Box
                      position="absolute"
                      top="-50%"
                      right="-50%"
                      w="200px"
                      h="200px"
                      borderRadius="full"
                      bg={`radial-gradient(circle at center, ${accentColor}20, transparent)`}
                      opacity="0.5"
                      filter="blur(40px)"
                    />
                    
                    <VStack spacing={8} align="start" position="relative" zIndex={1}>
                      <MotionHeading
                        as="h1"
                        fontSize={{ base: "4xl", sm: "5xl", md: "6xl", lg: "7xl" }}
                        fontWeight="900"
                        color="gray.800"
                        lineHeight="1.1"
                        bgGradient={accentGradient}
                        bgClip="text"
                        initial={{ opacity: 0, y: 30 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.8, delay: 0.6 }}
                      >
                        {product.name}
                      </MotionHeading>
                      
                      <MotionText
                        fontSize="xl"
                        color="gray.700"
                        lineHeight="1.8"
                        fontWeight="500"
                        initial={{ opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.8, delay: 0.8 }}
                      >
                        {product.description}
                      </MotionText>

                      {/* Premium Rating & Reviews */}
                      <MotionBox
                        initial={{ opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.8, delay: 1.0 }}
                        w="100%"
                      >
                        <HStack 
                          spacing={6} 
                          p={6} 
                          bg="white" 
                          borderRadius="xl" 
                          border={`1px solid ${accentColor}30`}
                          boxShadow={`0 10px 20px ${accentShadow10}`}
                        >
                          <HStack spacing={2}>
                            {[...Array(5)].map((_, i) => (
                              <Icon key={i} as={FaStar} color={accentLight} boxSize={6} />
                            ))}
                          </HStack>
                          <Text color="gray.700" fontWeight="600" fontSize="lg">
                            (4.8/5) • 127 Premium Reviews
                          </Text>
                        </HStack>
                      </MotionBox>
                    </VStack>
                  </Box>

                  {/* Key Features */}
                  <Box 
                    bg={cardBg}
                    backdropFilter="blur(30px)"
                    boxShadow={`0 20px 40px ${accentShadow20}`}
                    borderRadius="3xl" 
                    p={12}
                    border={`1px solid ${accentColor}30`}
                    position="relative"
                    overflow="hidden"
                  >
                    {/* Elegant background accent */}
                    <Box
                      position="absolute"
                      bottom="-30%"
                      left="-30%"
                      w="150px"
                      h="150px"
                      borderRadius="full"
                      bg={`radial-gradient(circle at center, ${accentColor}20, transparent)`}
                      opacity="0.5"
                      filter="blur(30px)"
                    />
                    
                    <VStack spacing={8} align="stretch" position="relative" zIndex={1}>
                      <MotionHeading 
                        fontSize="3xl" 
                        fontWeight="800" 
                        color="gray.800"
                        bgGradient={accentGradient}
                        bgClip="text"
                        initial={{ opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.8, delay: 1.2 }}
                      >
                        <Icon as={FaCrown} mr={3} color={accentColor} />
                        Why Choose This Premium Product?
                      </MotionHeading>
                      
                      <SimpleGrid 
                        columns={{ base: 1, sm: 2, md: 2 }} 
                        spacing={{ base: 4, sm: 6 }}
                        mx={{ base: -2, sm: 0 }}
                      >
                        {[
                          { icon: FaAward, text: 'Premium Quality', desc: 'Top-grade materials & craftsmanship', gradient: `linear-gradient(135deg, ${accentColor}, ${accentLight})` },
                          { icon: FaShieldAlt, text: 'Durable Design', desc: 'Long-lasting performance', gradient: `linear-gradient(135deg, ${accentLight}, ${accentColor})` },
                          { icon: FaTools, text: 'Easy Installation', desc: 'Simple setup process', gradient: `linear-gradient(135deg, ${accentColor}, ${accentDark})` },
                          { icon: FaMagic, text: 'Modern Elegance', desc: 'Contemporary luxury style', gradient: `linear-gradient(135deg, ${accentDark}, ${accentColor})` }
                        ].map((feature, index) => (
                          <MotionBox
                            key={index}
                            p={8}
                            bg="white"
                            borderRadius="2xl"
                            border="1px solid"
                            borderColor={accentColor}
                            boxShadow={`0 10px 20px ${accentShadow10}`}
                            _hover={{
                              bg: "white",
                              borderColor: accentColor,
                              transform: "translateY(-8px)",
                              boxShadow: `0 20px 40px ${accentShadow20}`
                            }}
                            initial={{ opacity: 0, y: 30 }}
                            animate={{ opacity: 1, y: 0 }}
                            transition={{ duration: 0.6, delay: 1.4 + index * 0.1 }}
                          >
                            <HStack spacing={6} align="start">
                              <Box
                                p={4}
                                bgGradient={feature.gradient}
                                borderRadius="2xl"
                                color="white"
                                boxShadow={`0 10px 20px ${accentShadow20}`}
                              >
                                <Icon as={feature.icon} boxSize={8} />
                              </Box>
                              <VStack align="start" spacing={2}>
                                <Text color="gray.800" fontWeight="800" fontSize="xl">
                                  {feature.text}
                                </Text>
                                <Text color="gray.600" fontSize="md" fontWeight="500">
                                  {feature.desc}
                                </Text>
                              </VStack>
                            </HStack>
                          </MotionBox>
                        ))}
                      </SimpleGrid>
                    </VStack>
                  </Box>

                  {/* Contact Section */}
                  <Box 
                    bg={cardBg}
                    backdropFilter="blur(30px)"
                    boxShadow={`0 20px 40px ${accentShadow20}`}
                    borderRadius="3xl" 
                    p={12}
                    border={`1px solid ${accentColor}30`}
                    position="relative"
                    overflow="hidden"
                  >
                    {/* Elegant background accent */}
                    <Box
                      position="absolute"
                      top="-20%"
                      right="-20%"
                      w="180px"
                      h="180px"
                      borderRadius="full"
                      bg={`radial-gradient(circle at center, ${accentColor}20, transparent)`}
                      opacity="0.5"
                      filter="blur(40px)"
                    />
                    
                    <VStack spacing={8} align="stretch" position="relative" zIndex={1}>
                      <MotionBox
                        initial={{ opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.8, delay: 1.8 }}
                      >
                        <VStack spacing={4} align="start">
                          <Heading 
                            fontSize="3xl" 
                            fontWeight="800" 
                            color="gray.800"
                            bgGradient={accentGradient}
                            bgClip="text"
                          >
                            <Icon as={FaGem} mr={3} color={accentColor} />
                            Get Premium Consultation
                          </Heading>
                          <Text 
                            color="gray.600" 
                            fontSize="xl" 
                            fontWeight="500"
                            lineHeight="1.6"
                          >
                            Contact our experts for detailed information, pricing, and personalized recommendations.
                          </Text>
                        </VStack>
                      </MotionBox>

                      {/* Premium Contact Buttons */}
                      <VStack spacing={{ base: 4, md: 6 }}>
                        <MotionBox
                          w="100%"
                          initial={{ opacity: 0, y: 20 }}
                          animate={{ opacity: 1, y: 0 }}
                          transition={{ duration: 0.8, delay: 2.0 }}
                        >
                          <Button
                            w="100%"
                            bgGradient={accentGradient}
                            color="white"
                            leftIcon={<FaWhatsapp />}
                            size="xl"
                            fontWeight="800"
                            borderRadius="2xl"
                            py={8}
                            fontSize="lg"
                            boxShadow={`0 10px 20px ${accentShadow20}`}
                            _hover={{ 
                              transform: "translateY(-4px)",
                              boxShadow: `0 20px 40px ${accentShadow30}`
                            }}
                            onClick={() => handleContactClick('whatsapp')}
                            transition="all 0.4s ease"
                          >
                            Contact via WhatsApp
                          </Button>
                        </MotionBox>

                        <MotionBox
                          w="100%"
                          initial={{ opacity: 0, y: 20 }}
                          animate={{ opacity: 1, y: 0 }}
                          transition={{ duration: 0.8, delay: 2.2 }}
                        >
                          <Button
                            w="100%"
                            bg="white"
                            color={accentColor}
                            leftIcon={<FaPhone />}
                            size="xl"
                            fontWeight="800"
                            borderRadius="2xl"
                            py={8}
                            fontSize="lg"
                            border={`2px solid ${accentColor}`}
                            boxShadow={`0 10px 20px ${accentShadow20}`}
                            _hover={{ 
                              transform: "translateY(-4px)",
                              boxShadow: `0 20px 40px ${accentShadow30}`,
                              bg: accentColor,
                              color: "white"
                            }}
                            onClick={() => handleContactClick('phone')}
                            transition="all 0.4s ease"
                          >
                            Call Our Experts
                          </Button>
                        </MotionBox>

                        <MotionBox
                          w="100%"
                          initial={{ opacity: 0, y: 20 }}
                          animate={{ opacity: 1, y: 0 }}
                          transition={{ duration: 0.8, delay: 2.4 }}
                        >
                          <Button
                            w="100%"
                            bg="white"
                            color={accentColor}
                            leftIcon={<FaEnvelope />}
                            size="xl"
                            fontWeight="800"
                            borderRadius="2xl"
                            py={8}
                            fontSize="lg"
                            border={`2px solid ${accentColor}`}
                            boxShadow={`0 10px 20px ${accentShadow20}`}
                            _hover={{ 
                              transform: "translateY(-4px)",
                              boxShadow: `0 20px 40px ${accentShadow30}`,
                              bg: accentColor,
                              color: "white"
                            }}
                            onClick={() => handleContactClick('email')}
                            transition="all 0.4s ease"
                          >
                            Send Detailed Inquiry
                          </Button>
                        </MotionBox>
                      </VStack>

                      <Box 
                        w="100%" 
                        h="1px" 
                        bg={`${accentColor}30`}
                        my={6}
                      />

                      {/* Premium Contact Information */}
                      <MotionBox
                        bg="white"
                        p={8}
                        borderRadius="2xl"
                        border={`1px solid ${accentColor}30`}
                        boxShadow={`0 10px 20px ${accentShadow10}`}
                        initial={{ opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.8, delay: 2.6 }}
                      >
                        <VStack spacing={6}>
                          <Text fontSize="xl" fontWeight="800" color="gray.800">
                            <Icon as={FaCheckCircle} mr={2} color={accentColor} />
                            Premium Contact Information
                          </Text>
                          <VStack spacing={{ base: 3, md: 4 }} w="100%">
                            <HStack
                              p={{ base: 4, md: 6 }}
                              bg="white"
                              borderRadius={{ base: "xl", md: "2xl" }}
                              w="100%"
                              border={`1px solid ${accentColor}30`}
                              boxShadow={`0 10px 20px ${accentShadow10}`}
                              _hover={{ 
                                borderColor: accentColor,
                                transform: "translateY(-2px)",
                                boxShadow: `0 15px 30px ${accentShadow20}`
                              }}
                              transition="all 0.3s ease"
                            >
                              <Icon as={FaMapMarkerAlt} color={accentColor} boxSize={6} />
                              <Text color="gray.800" fontWeight="700" fontSize="lg">
                                R Diamond Bathroom Fittings, Delhi
                              </Text>
                            </HStack>
                            <HStack
                              p={6}
                              bg="white"
                              borderRadius="2xl"
                              w="100%"
                              border={`1px solid ${accentColor}30`}
                              boxShadow={`0 10px 20px ${accentShadow10}`}
                              _hover={{ 
                                borderColor: accentColor,
                                transform: "translateY(-2px)",
                                boxShadow: `0 15px 30px ${accentShadow20}`
                              }}
                              transition="all 0.3s ease"
                            >
                              <Icon as={FaPhone} color={accentColor} boxSize={6} />
                              <Text color="gray.800" fontWeight="700" fontSize="lg">
                                +91 98765 43210
                              </Text>
                            </HStack>
                            <HStack
                              p={6}
                              bg="white"
                              borderRadius="2xl"
                              w="100%"
                              border={`1px solid ${accentColor}30`}
                              boxShadow={`0 10px 20px ${accentShadow10}`}
                              _hover={{ 
                                borderColor: accentColor,
                                transform: "translateY(-2px)",
                                boxShadow: `0 15px 30px ${accentShadow20}`
                              }}
                              transition="all 0.3s ease"
                            >
                              <Icon as={FaEnvelope} color={accentColor} boxSize={6} />
                              <Text color="gray.800" fontWeight="700" fontSize="lg">
                                rdiamond2423@gmail.com
                              </Text>
                            </HStack>
                          </VStack>
                        </VStack>
                      </MotionBox>
                    </VStack>
                  </Box>
                </VStack>
              </MotionBox>
            </GridItem>
          </Grid>
        </Container>
      </Box>
    </Box>
  );
};

export default ProductDetailPage;